<Window x:Class="EmployeeCrud.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Admin Login"
        Width="460"
        Height="590"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F3F6FA"
        FontFamily="Segoe UI"
        FontSize="14">

    <Border Margin="25"
            Padding="28"
            Background="White"
            CornerRadius="12">

        <StackPanel Height="486" VerticalAlignment="Top">
            <TextBlock Text="EMPLOYEE MANAGEMENT"
                       FontSize="12"
                       FontWeight="Bold"
                       Foreground="#167568"/>

            <TextBlock x:Name="HeadingText"
                       Text="Admin login"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Margin="0,12,0,8"/>

            <TextBlock x:Name="DescriptionText"
                       Text="Sign in to manage employees."
                       Foreground="#64748B"
                       TextWrapping="Wrap"
                       Margin="0,0,0,22"/>

            <TextBlock Text="Username"
                       Margin="0,0,0,6"/>

            <TextBox x:Name="UsernameBox"
                     MaxLength="50"
                     Padding="10"
                     AutomationProperties.Name="Username"/>

            <TextBlock Text="Password"
                       Margin="0,16,0,6"/>

            <PasswordBox x:Name="PasswordInput"
                         MaxLength="128"
                         Padding="10"
                         AutomationProperties.Name="Password"/>

            <StackPanel x:Name="ConfirmPanel"
                        Visibility="Collapsed">
                <TextBlock Text="Confirm password"
                           Margin="0,16,0,6"/>

                <PasswordBox x:Name="ConfirmPasswordInput"
                             MaxLength="128"
                             Padding="10"
                             AutomationProperties.Name="Confirm password"/>
            </StackPanel>

            <TextBlock x:Name="MessageText"
                       Foreground="#B42318"
                       TextWrapping="Wrap"
                       Margin="0,16,0,0"
                       AutomationProperties.LiveSetting="Polite"/>
            <Button x:Name="SubmitButton"
                    Content="Log in"
                    Click="Submit_Click"
                    IsDefault="True"
                    Background="#167568"
                    Foreground="White"
                    Padding="12"
                    />
        </StackPanel>
    </Border>
</Window>